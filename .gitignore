# ==========================================
# Nova Desktop Pet (.gitignore)
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Sensitive Configuration & API Keys (DO NOT COMMIT)
config/api.ini
AI API URL.txt
*.env
*.key

# User Dynamic Data & Machine-Specific State
config/history.json
config/memory.json
config/apps.json
config/app_preferences.json
data/runtime/

# Logs
logs/
*.log

# IDE & Local Tooling Caches
.vscode/
.idea/
.codegraph/
codegraph.html
*.swp
*~

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
